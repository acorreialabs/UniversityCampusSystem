# Variáveis para provisionamento automático (Neon + Render)
# Copiar: cp .env.deploy.example .env.deploy
# Nunca commitar .env.deploy

# Neon — https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
NEON_PROJECT_NAME=smart-campus-core
NEON_REGION=aws-eu-central-1

# Preenchido automaticamente por .scripts/provision-neon.sh
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require

# Render — opcional, validação API do blueprint
# RENDER_API_KEY=
# RENDER_OWNER_ID=

# URLs após deploy (para verify-deploy.sh)
# API_URL=https://smart-campus-api.onrender.com
# WEB_URL=https://smart-campus-web.onrender.com

# Abrir browser no link Render ao correr provision-deploy.sh
# OPEN_RENDER=true

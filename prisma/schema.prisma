generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  STUDENT
  TEACHER
  TECHNICIAN
  COORDINATOR
  ADMIN
  FINANCE
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  fullName     String
  isActive     Boolean        @default(true)
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  reportedIncidents Incident[] @relation("IncidentReporter")
  assignedIncidents Incident[] @relation("IncidentAssignee")
  auditEvents  AuditEvent[]
  notifications Notification[]
  maintenanceActions MaintenanceAction[]
  periodsValidated      Period[]              @relation("PeriodValidatedBy")
  assessmentsCreated    Assessment[]          @relation("AssessmentOwner")
  gradesGiven           Grade[]               @relation("GradeAuthor")
  schedulesTaught       ClassSchedule[]       @relation("ScheduleTeacher")
  attendanceRecorded    Attendance[]          @relation("AttendanceRecordedBy")
  exemptionsGiven       SubjectExemption[]    @relation("SubjectExemptionAuthor")
  financialDebts         Debt[]                  @relation("DebtStudent")
  financialPayments      Payment[]               @relation("PaymentStudent")
  confirmedPayments      Payment[]               @relation("PaymentConfirmer")
  financialStatus        FinancialStatus?         @relation("FinancialStatusStudent")
  analysisRequests       AnalysisRequest[]       @relation("AnalysisRequestStudent")
  resolvedAnalysisRequests AnalysisRequest[]     @relation("AnalysisRequestResolver")
  financialNotifications FinancialNotification[] @relation("FinancialNotificationStudent")



  @@index([roleId])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
  teachers    TeacherProfile[]
}

model Course {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subjects     Subject[]
  students     StudentProfile[]
  enrolments   Enrolment[]
  schedules    ClassSchedule[]

  @@index([departmentId])
}

model Subject {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  credits   Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assessments             Assessment[]
  schedules               ClassSchedule[]
  requiredTestCount       Int?
  // Nota mínima de admissão (0–20) para o estudante poder recorrer.
  // null = regra institucional não configurada (sinalizado na API e bloqueia publicação).
  recurrenceMinAdmission  Float?
  // Estado de publicação da pauta da disciplina. Enquanto publicada, as
  // notas não podem ser alteradas (reabertura explícita e auditada).
  resultsPublishedAt      DateTime?
  resultsPublishedById    String?
  exemptions              SubjectExemption[]

  subjectEnrolments SubjectEnrolment[]

  @@index([courseId])
}

enum StudentProfileStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum TeacherProfileStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model StudentProfile {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber String               @unique
  courseId      String?
  course        Course?              @relation(fields: [courseId], references: [id])
  yearOfStudy   Int?
  phone         String?
  status        StudentProfileStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  enrolments        Enrolment[]
  subjectEnrolments SubjectEnrolment[]
  grades            Grade[]
  attendance        Attendance[]
  periodResults     PeriodResult[]
  exemptions        SubjectExemption[]

  @@index([courseId])
}

model TeacherProfile {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String               @unique
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id])
  title        String?
  phone        String?
  status       TeacherProfileStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  salaries     TeacherSalary[]

  @@index([departmentId])
}

enum SalaryStatus {
  PENDING
  PAID
}

// Registo financeiro mensal. O cadastro académico continua no Core.
model TeacherSalary {
  id            String       @id @default(cuid())
  teacherId     String
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  month         String
  amount        Decimal      @db.Decimal(10, 2)
  notes         String       @default("")
  status        SalaryStatus @default(PENDING)
  paymentMethod PaymentMethod?
  referenceCode String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([teacherId, month])
  @@unique([paymentMethod, referenceCode])
  @@index([month, status])
  @@index([paidAt])
  @@map("teacher_salaries")
}

model Enrolment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id])
  academicYear String
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([studentId, courseId, academicYear])
  @@index([courseId])
}

enum EnrolmentStatus {
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
}

model SubjectEnrolment {
  id           String          @id @default(cuid())
  studentId    String
  student      StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  academicYear Int
  status       EnrolmentStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([studentId, subjectId, academicYear])
  @@index([subjectId])
}

model Building {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  floors      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
  laboratories Laboratory[]
}

model Room {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  capacity    Int
  floor       Int        @default(0)
  status      RoomStatus @default(AVAILABLE)
  buildingId  String
  building    Building   @relation(fields: [buildingId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  equipment   Equipment[]
  incidents   Incident[]
  devices     Device[]

  @@index([buildingId])
  @@index([status])
}

model Laboratory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  equipment   Equipment[]

  @@index([buildingId])
}

model Equipment {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  description   String?
  roomId        String?
  room          Room?        @relation(fields: [roomId], references: [id])
  laboratoryId  String?
  laboratory    Laboratory?  @relation(fields: [laboratoryId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  incidents     Incident[]

  @@index([roomId])
  @@index([laboratoryId])
}

model Incident {
  id           String           @id @default(cuid())
  title        String
  description  String
  status       IncidentStatus   @default(OPEN)
  priority     IncidentPriority @default(MEDIUM)
  roomId       String?
  room         Room?            @relation(fields: [roomId], references: [id])
  equipmentId  String?
  equipment    Equipment?       @relation(fields: [equipmentId], references: [id])
  reporterId   String
  reporter     User             @relation("IncidentReporter", fields: [reporterId], references: [id])
  assigneeId   String?
  assignee     User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  closedAt     DateTime?
  maintenanceActions MaintenanceAction[]

  @@index([status])
  @@index([priority])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([roomId])
}

model MaintenanceAction {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  performedBy String
  performer   User     @relation(fields: [performedBy], references: [id])
  notes       String
  createdAt   DateTime @default(now())

  @@index([incidentId])
}

model Device {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  type        String
  status      DeviceStatus @default(UNKNOWN)
  roomId      String?
  room        Room?        @relation(fields: [roomId], references: [id])
  mqttTopic   String?
  lastSeenAt DateTime?
  signal     Int?
  battery    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sensors     Sensor[]
  alerts      Alert[]

  @@index([status])
  @@index([roomId])
}

model Sensor {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  metric    String
  unit      String?
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readings  Reading[]
  alerts    Alert[]

  @@index([deviceId])
}

model Reading {
  id        String   @id @default(cuid())
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value     Float
  recordedAt DateTime @default(now())
  isDemo    Boolean  @default(true)

  @@index([sensorId, recordedAt])
}

model Alert {
  id          String        @id @default(cuid())
  title       String
  message     String
  severity    AlertSeverity @default(INFO)
  sensorId    String?
  sensor      Sensor?       @relation(fields: [sensorId], references: [id])
  acknowledged Boolean      @default(false)
  isDemo      Boolean       @default(true)
  deviceId    String?
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt


  @@index([deviceId])
  @@index([severity])
  @@index([acknowledged])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  action         String
  resource       String
  resourceId     String?
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  correlationId  String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([action])
  @@index([resource])
  @@index([actorId])
  @@index([correlationId])
  @@index([createdAt])
}

enum ParkingSpotStatus {
  FREE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum PlateDirection {
  IN
  OUT
}

model ParkingLot {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  capacity    Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  spots       ParkingSpot[]
  readings    PlateReading[]
}

model ParkingSpot {
  id         String            @id @default(cuid())
  code       String
  rowLabel   String
  level      Int               @default(0)
  status     ParkingSpotStatus @default(FREE)
  plate      String?
  lotId      String
  lot        ParkingLot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  readings   PlateReading[]

  @@unique([lotId, code])
  @@index([lotId, status])
}

model PlateReading {
  id           String         @id @default(cuid())
  plate        String
  direction    PlateDirection
  confidence   Float          @default(0.9)
  photoUrl     String?
  sensorCode   String
  isDemo       Boolean        @default(true)
  lotId        String
  lot          ParkingLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  spotId       String?
  spot         ParkingSpot?   @relation(fields: [spotId], references: [id], onDelete: SetNull)
  recordedAt   DateTime       @default(now())

  @@index([lotId, recordedAt])
  @@index([plate])
  @@index([spotId])
}

// ====== Módulo 3 — G3: Avaliações, Notas, Assiduidade e Horários ======
enum AssessmentType {
  TEST
  EXAM
  ASSIGNMENT
  PRACTICAL
  ORAL
  OTHER
  RECURRENCE
}

enum GradingMode {
  PERCENTAGE
  POINTS
  SCALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  JUSTIFIED
}

enum PeriodType {
  SEMESTER
  TRIMESTER
  QUARTER
  ANNUAL
}

enum GradingScope {
  GLOBAL
  COURSE
  SUBJECT
  PERIOD
}

model AcademicYear {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  periods     Period[]
}

model Period {
  id             String       @id @default(cuid())
  code           String
  name           String
  type           PeriodType   @default(SEMESTER)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  closed         Boolean      @default(false)
  validatedAt    DateTime?
  validatedById  String?
  validatedBy    User?        @relation("PeriodValidatedBy", fields: [validatedById], references: [id])
  description    String?
  periodResults  PeriodResult[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, code])
  @@index([academicYearId])
  @@index([closed])
}

model GradingConfig {
  id          String       @id @default(cuid())
  scope       GradingScope @default(COURSE)
  scopeId     String
  name        String
  rules       Json
  appliesFrom DateTime?
  appliesTo   DateTime?
  active      Boolean      @default(true)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([scope, scopeId])
  @@index([active])
}

model PeriodResult {
  id               String         @id @default(cuid())
  periodId         String
  period           Period         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  averagePercent   Float?
  averageGrade     Int?
  creditsAttempted Int            @default(0)
  creditsObtained  Int            @default(0)
  status           String?
  complete         Boolean        @default(false)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([periodId, studentId])
  @@index([studentId])
  @@index([periodId])
}

model Assessment {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        AssessmentType @default(TEST)
  gradingMode GradingMode    @default(PERCENTAGE)
  maxScore    Float          @default(20)
  weight      Float
  date        DateTime?
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id])
  createdById String
  createdBy   User           @relation("AssessmentOwner", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  grades      Grade[]

  @@index([subjectId])
  @@index([createdById])
}

model Grade {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  value        Float
  valuePercent Float
  comment      String?
  gradedById   String
  gradedBy     User           @relation("GradeAuthor", fields: [gradedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

model ClassSchedule {
  id        String   @id @default(cuid())
  title     String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  teacherId String?
  teacher   User?    @relation("ScheduleTeacher", fields: [teacherId], references: [id])
  roomId    String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendance Attendance[]

  @@index([courseId])
  @@index([subjectId])
  @@index([teacherId])
}

model Attendance {
  id               String         @id @default(cuid())
  classScheduleId  String
  classSchedule    ClassSchedule  @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  status           AttendanceStatus
  note             String?
  recordedById     String?
  recordedBy       User?          @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  recordedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([classScheduleId, studentProfileId])
  @@index([studentProfileId])
  @@index([classScheduleId])
  @@index([status])
}

model SubjectExemption {
  id           String         @id @default(cuid())
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exemptedById String
  exemptedBy   User           @relation("SubjectExemptionAuthor", fields: [exemptedById], references: [id])
  reason       String?
  /** Nota de dispensa (0–20) escolhida pelo docente; null = usa a nota de admissão. */
  grade        Float?
  createdAt    DateTime       @default(now())

  @@unique([subjectId, studentId])
  @@index([subjectId])
  @@index([studentId])
}

enum DebtStatus {
  PENDENTE
  VENCIDA
  REGULARIZADA
  CANCELADA
}

enum FinancialStatusType {
  ACTIVE
  BLOCKED
}

enum AnalysisRequestStatus {
  PENDENTE_ANALISE
  PROCEDENTE
  IMPROCEDENTE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_DEPOSIT
  MOBILE_MONEY
  POS
}

// Divida: propina, multa ou taxa emitida para um estudante
model Debt {
  id               String            @id @default(cuid())
  code             String            @unique
  studentId        String
  title            String
  description      String?
  amount           Decimal           @db.Decimal(10, 2)
  origin           String
  dueDate          DateTime
  status           DebtStatus        @default(PENDENTE)
  payments         Payment[]
  analysisRequests AnalysisRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  student User @relation("DebtStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId, status])
  @@index([dueDate])
  @@map("debts")
}

// Pagamento: confirmacao de liquidacao de uma divida
model Payment {
  id            String        @id @default(cuid())
  code          String        @unique
  debtId        String
  studentId     String
  amountPaid    Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  referenceCode String
  confirmedById String
  paidAt        DateTime      @default(now())
  debt          Debt          @relation(fields: [debtId], references: [id])
  createdAt     DateTime      @default(now())

  student User @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy User @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId])
  @@index([debtId])
  @@unique([paymentMethod, referenceCode])
  @@unique([debtId])
  @@map("payments")
}

// Estado financeiro: registo unico por estudante (ACTIVE ou BLOCKED)
model FinancialStatus {
  id        String              @id @default(cuid())
  studentId String              @unique
  status    FinancialStatusType @default(ACTIVE)
  blockedAt DateTime?
  reason    String?
  updatedAt DateTime            @updatedAt

  student User @relation("FinancialStatusStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId, status])
  @@map("financial_status")
}

// Pedido de analise: contestacao formal de uma divida pelo estudante
model AnalysisRequest {
  id              String                @id @default(cuid())
  code            String                @unique
  debtId          String
  studentId       String
  reason          String
  status          AnalysisRequestStatus @default(PENDENTE_ANALISE)
  slaDueDate      DateTime
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNotes String?
  debt            Debt                  @relation(fields: [debtId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  student User @relation("AnalysisRequestStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy User? @relation("AnalysisRequestResolver", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId, status])
  @@index([debtId])
  @@map("analysis_requests")
}

enum NotificationDeliveryStatus {
  LOCAL_ONLY
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Aviso financeiro e registo persistente de envio para a API externa de notificacoes.
model FinancialNotification {
  id        String   @id @default(cuid())
  studentId String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  eventType              String                     @default("FINANCIAL_NOTICE")
  resourceId             String?
  correlationId          String?
  deliveryStatus         NotificationDeliveryStatus @default(PENDING)
  externalNotificationId String?                    @unique
  attempts               Int                        @default(0)
  nextAttemptAt          DateTime                   @default(now())
  lastAttemptAt          DateTime?
  sentAt                 DateTime?
  lastError              String?
  lockedUntil            DateTime?
  lockToken              String?

  student User @relation("FinancialNotificationStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId, read])
  @@index([deliveryStatus, nextAttemptAt])
  @@map("financial_notifications")
}

// Politica financeira: configuracao global de regras de bloqueio e tolerancia
model FinancialPolicy {
  id               String   @id @default(cuid())
  code             String   @unique @default("DEFAULT_POLICY")
  gracePeriodDays  Int      @default(5)
  autoBlockEnabled Boolean  @default(true)
  maxDebtAmount    Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt

  @@map("financial_policies")
}

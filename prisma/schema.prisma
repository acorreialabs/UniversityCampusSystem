generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  STUDENT
  TEACHER
  TECHNICIAN
  COORDINATOR
  ADMIN
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  fullName           String
  isActive           Boolean             @default(true)
  roleId             String
  role               Role                @relation(fields: [roleId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  reportedIncidents  Incident[]          @relation("IncidentReporter")
  assignedIncidents  Incident[]          @relation("IncidentAssignee")
  periodsValidated   Period[] @relation("PeriodValidatedBy")
  auditEvents        AuditEvent[]
  notifications      Notification[]
  maintenanceActions MaintenanceAction[]
  assessmentsCreated Assessment[]        @relation("AssessmentOwner")
  gradesGiven        Grade[]             @relation("GradeAuthor")
  schedulesTaught    ClassSchedule[]     @relation("ScheduleTeacher")
  attendanceRecorded Attendance[]        @relation("AttendanceRecordedBy")
  exemptionsGiven    SubjectExemption[]  @relation("SubjectExemptionAuthor")

  @@index([roleId])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Department {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  courses     Course[]
  teachers    TeacherProfile[]
}

model Course {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  description  String?
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  subjects     Subject[]
  students     StudentProfile[]
  enrolments   Enrolment[]
  schedules    ClassSchedule[]

  @@index([departmentId])
}

model Subject {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  credits     Int             @default(0)
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  assessments Assessment[]
  schedules   ClassSchedule[]
  requiredTestCount Int?
  // Nota mínima de admissão (0–20) para o estudante poder recorrer.
  // null = regra institucional não configurada (sinalizado na API e bloqueia publicação).
  recurrenceMinAdmission Float?
  // Estado de publicação da pauta da disciplina. Enquanto publicada, as
  // notas não podem ser alteradas (reabertura explícita e auditada).
  resultsPublishedAt   DateTime?
  resultsPublishedById String?
  exemptions           SubjectExemption[]

  @@index([courseId])
}

model StudentProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber String       @unique
  courseId      String?
  course        Course?      @relation(fields: [courseId], references: [id])
  yearOfStudy   Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrolments    Enrolment[]
  grades        Grade[]
  attendance    Attendance[]
  periodResults PeriodResult[]
  exemptions    SubjectExemption[]
  financialStatus FinancialStatus?

  @@index([courseId])
}

model TeacherProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId])
}

model Enrolment {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id])
  academicYear String
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([studentId, courseId, academicYear])
  @@index([courseId])
}

model Building {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  floors       Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  rooms        Room[]
  laboratories Laboratory[]
}

model Room {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  capacity   Int
  floor      Int         @default(0)
  status     RoomStatus  @default(AVAILABLE)
  buildingId String
  building   Building    @relation(fields: [buildingId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  equipment  Equipment[]
  incidents  Incident[]
  devices    Device[]

  @@index([buildingId])
  @@index([status])
}

model Laboratory {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  buildingId  String
  building    Building    @relation(fields: [buildingId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]

  @@index([buildingId])
}

model Equipment {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  description  String?
  roomId       String?
  room         Room?       @relation(fields: [roomId], references: [id])
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  incidents    Incident[]

  @@index([roomId])
  @@index([laboratoryId])
}

model Incident {
  id                 String              @id @default(cuid())
  title              String
  description        String
  status             IncidentStatus      @default(OPEN)
  priority           IncidentPriority    @default(MEDIUM)
  roomId             String?
  room               Room?               @relation(fields: [roomId], references: [id])
  equipmentId        String?
  equipment          Equipment?          @relation(fields: [equipmentId], references: [id])
  reporterId         String
  reporter           User                @relation("IncidentReporter", fields: [reporterId], references: [id])
  assigneeId         String?
  assignee           User?               @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedAt           DateTime?
  maintenanceActions MaintenanceAction[]

  @@index([status])
  @@index([priority])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([roomId])
}

model MaintenanceAction {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  performedBy String
  performer   User     @relation(fields: [performedBy], references: [id])
  notes       String
  createdAt   DateTime @default(now())

  @@index([incidentId])
}

model Device {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  type      String
  status    DeviceStatus @default(UNKNOWN)
  roomId    String?
  room      Room?        @relation(fields: [roomId], references: [id])
  mqttTopic String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sensors   Sensor[]

  @@index([status])
  @@index([roomId])
}

model Sensor {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  metric    String
  unit      String?
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readings  Reading[]
  alerts    Alert[]

  @@index([deviceId])
}

model Reading {
  id         String   @id @default(cuid())
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value      Float
  recordedAt DateTime @default(now())
  isDemo     Boolean  @default(true)

  @@index([sensorId, recordedAt])
}

model Alert {
  id           String        @id @default(cuid())
  title        String
  message      String
  severity     AlertSeverity @default(INFO)
  sensorId     String?
  sensor       Sensor?       @relation(fields: [sensorId], references: [id])
  acknowledged Boolean       @default(false)
  isDemo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([severity])
  @@index([acknowledged])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  action        String
  resource      String
  resourceId    String?
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  correlationId String
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([resource])
  @@index([actorId])
  @@index([correlationId])
  @@index([createdAt])
}

enum AssessmentType {
  TEST
  EXAM
  ASSIGNMENT
  PRACTICAL
  ORAL
  OTHER
  RECURRENCE
}

enum GradingMode {
  PERCENTAGE
  POINTS
  SCALE
}

enum ParkingSpotStatus {
  FREE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum PlateDirection {
  IN
  OUT
}

model ParkingLot {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  capacity    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  spots       ParkingSpot[]
  readings    PlateReading[]
}

model ParkingSpot {
  id        String            @id @default(cuid())
  code      String
  rowLabel  String
  level     Int               @default(0)
  status    ParkingSpotStatus @default(FREE)
  plate     String?
  lotId     String
  lot       ParkingLot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  readings  PlateReading[]

  @@unique([lotId, code])
  @@index([lotId, status])
}

model PlateReading {
  id         String         @id @default(cuid())
  plate      String
  direction  PlateDirection
  confidence Float          @default(0.9)
  photoUrl   String?
  sensorCode String
  isDemo     Boolean        @default(true)
  lotId      String
  lot        ParkingLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  spotId     String?
  spot       ParkingSpot?   @relation(fields: [spotId], references: [id], onDelete: SetNull)
  recordedAt DateTime       @default(now())

  @@index([lotId, recordedAt])
  @@index([plate])
  @@index([spotId])
}

model Assessment {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        AssessmentType @default(TEST)
  gradingMode GradingMode    @default(PERCENTAGE)
  maxScore    Float          @default(20)
  weight      Float
  date        DateTime?
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id])
  createdById String
  createdBy   User           @relation("AssessmentOwner", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  grades      Grade[]

  @@index([subjectId])
  @@index([createdById])
}

model Grade {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  value        Float
  valuePercent Float
  comment      String?
  gradedById   String
  gradedBy     User           @relation("GradeAuthor", fields: [gradedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

model ClassSchedule {
  id         String       @id @default(cuid())
  title      String
  subjectId  String
  subject    Subject      @relation(fields: [subjectId], references: [id])
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id])
  teacherId  String?
  teacher    User?        @relation("ScheduleTeacher", fields: [teacherId], references: [id])
  roomId     String?
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendance Attendance[]

  @@index([courseId])
  @@index([subjectId])
  @@index([teacherId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  JUSTIFIED
}

model Attendance {
  id               String           @id @default(cuid())
  classScheduleId  String
  classSchedule    ClassSchedule    @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  status           AttendanceStatus
  note             String?
  recordedById     String?
  recordedBy       User?            @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  recordedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([classScheduleId, studentProfileId])
  @@index([studentProfileId])
  @@index([classScheduleId])
  @@index([status])
}

model AcademicYear {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  periods     Period[]
}

enum PeriodType {
  SEMESTER
  TRIMESTER
  QUARTER
  ANNUAL
}

model Period {
  id             String     @id @default(cuid())
  code           String
  name           String
  type           PeriodType @default(SEMESTER)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  closed         Boolean    @default(false)
  validatedAt    DateTime?
  validatedById  String?
  validatedBy    User?      @relation("PeriodValidatedBy", fields: [validatedById], references: [id])
  description    String?
  periodResults  PeriodResult[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([academicYearId, code])
  @@index([academicYearId])
  @@index([closed])
}

enum GradingScope {
  GLOBAL
  COURSE
  SUBJECT
  PERIOD
}

model GradingConfig {
  id          String       @id @default(cuid())
  scope       GradingScope @default(COURSE)
  scopeId     String
  name        String
  rules       Json
  appliesFrom DateTime?
  appliesTo   DateTime?
  active      Boolean      @default(true)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([scope, scopeId])
  @@index([active])
}

model FinancialStatus {
  id                String          @id @default(cuid())
  studentId         String          @unique
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hasDebt           Boolean         @default(false)
  outstandingAmount Float           @default(0)
  status            String          @default("REGULAR")
  note              String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PeriodResult {
  id               String         @id @default(cuid())
  periodId         String
  period           Period         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  averagePercent   Float?
  averageGrade     Int?
  creditsAttempted Int            @default(0)
  creditsObtained  Int            @default(0)
  status           String?
  complete         Boolean        @default(false)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([periodId, studentId])
  @@index([studentId])
  @@index([periodId])
}

// Dispensa imposta pelo docente/coordenação para um estudante numa disciplina.
// Sobrepõe-se ao cálculo automático (admissão >= 14): o estado académico fica
// DISPENSADO, sem exame nem recorrência, e a decisão é auditada.
model SubjectExemption {
  id           String         @id @default(cuid())
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exemptedById String
  exemptedBy   User           @relation("SubjectExemptionAuthor", fields: [exemptedById], references: [id])
  reason       String?
  /** Nota de dispensa (0–20) escolhida pelo docente; null = usa a nota de admissão. */
  grade        Float?
  createdAt    DateTime       @default(now())

  @@unique([subjectId, studentId])
  @@index([subjectId])
  @@index([studentId])
}
